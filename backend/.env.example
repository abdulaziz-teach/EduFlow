# EduFlow Backend Production Environment Configuration Template
# DO NOT commit real production credentials to version control.

# Server Port (assigned dynamically by platform, defaults to 5000)
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Production Connection URI (MongoDB Atlas replica set)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/eduflow?retryWrites=true&w=majority

# High Entropy JWT Secret (min 32 characters, generated via e.g. `openssl rand -hex 32`)
JWT_SECRET=your_production_high_entropy_jwt_secret_min_32_characters_here

# Allowed Frontend Client Origin(s) (comma-separated for multiple domains)
CLIENT_URL=https://eduflow.app,https://www.eduflow.app

# OpenAI API Key (server-side only, never exposed to frontend)
AI_API_KEY=sk-your-openai-api-key-here

# Optional: AI Model Name (defaults to gpt-4o-mini)
AI_MODEL=gpt-4o-mini
