# EduFlow Backend Environment Configuration Template
# Copy this file to .env and fill in your values.
#
# SECURITY RULES FOR THIS FILE
# 1. NEVER put a real credential here — this template is committed to Git.
#    Every secret below is intentionally empty or an angle-bracket placeholder.
# 2. Any credential that was ever pasted into a repo, a .env.example, a screenshot,
#    a log line or a chat is considered COMPROMISED and must be rotated/revoked in
#    the issuing provider (OpenAI dashboard, MongoDB Atlas access list, Stripe
#    dashboard, …). Deleting it from this file does NOT invalidate it.
# 3. Generate high-entropy secrets outside the repo, e.g.:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. JWT secrets must be >= 32 characters and must be independent of each other.
#    Never derive one from the other.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Assigned dynamically by the platform; defaults to 5000
PORT=5000

# Environment mode (development | production | test)
NODE_ENV=development

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Development: local MongoDB instance
MONGO_URI=mongodb://localhost:27017/eduflow

# Production: MongoDB Atlas replica set URI (multi-document transactions require
# a replica set). Replace the <placeholders> only in your private .env:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# MONGODB_DB_NAME=eduflow
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=5
# REQUIRE_TRANSACTIONS=true

# ---------------------------------------------------------------------------
# JWT secrets — REQUIRED and enforced in production
# ---------------------------------------------------------------------------
# Access-token secret. Must exist, be >= 32 chars, not a known placeholder,
# and differ from JWT_REFRESH_SECRET. Production startup fails otherwise.
JWT_SECRET=

# Refresh-token secret. Must exist, be >= 32 chars, not a known placeholder,
# and differ from JWT_SECRET. It is NEVER derived from JWT_SECRET.
# (Refresh tokens themselves are opaque random values stored hashed; this
#  secret is reserved for any future signed refresh mechanism.)
JWT_REFRESH_SECRET=

# Legacy alias for the access secret (also accepted):
# JWT_ACCESS_SECRET=

# ---------------------------------------------------------------------------
# Frontend origins
# ---------------------------------------------------------------------------
# Comma-separated. Must not contain localhost/127.0.0.1 in production.
CLIENT_URL=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# AI provider (server-side only — never expose to the frontend)
# ---------------------------------------------------------------------------
# Leave empty here. Paste the real key into your private .env or the platform's
# secret store. A key that was ever committed must be revoked and reissued.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# MOCK_AI_LATENCY_MS=0

# ---------------------------------------------------------------------------
# Payments (Stripe)
# ---------------------------------------------------------------------------
# Secret keys are prefixed sk_live_ / sk_test_ — both are real credentials.
STRIPE_SECRET_KEY=
# Webhook signing secret (prefix whsec_). REQUIRED in production: signature
# verification refuses to run without it.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Notification channels (all optional; leave empty to disable the channel)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Test-only helpers (never use in production)
# ---------------------------------------------------------------------------
# MOCK_WEBHOOK_SECRET=
# The Stripe/Mock webhook secret falls back to a dev-only placeholder outside
# production; in production a missing STRIPE_WEBHOOK_SECRET throws.
