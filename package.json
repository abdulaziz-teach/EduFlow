{
  "name": "eduflow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run start:backend\" \"vite\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "start:backend": "npm --prefix backend run start",
    "seed:demo": "npm --prefix backend run seed:demo",
    "seed:production": "npm --prefix backend run seed:production",
    "migrate": "npm --prefix backend run migrate",
    "test": "npm --prefix backend test",
    "test:security": "npm --prefix backend run test:security",
    "test:backend": "npm --prefix backend run test",
    "test:adversarial": "npm --prefix backend run test:adversarial",
    "test:production": "npm --prefix backend run test:production",
    "test:search": "npm --prefix backend run test:search",
    "test:notifications": "npm --prefix backend run test:notifications",
    "test:billing": "npm --prefix backend run test:billing",
    "test:admin": "npm --prefix backend run test:admin",
    "test:reliability": "npm --prefix backend run test:reliability",
    "test:audit": "npm --prefix backend run test:audit",
    "test:e2e": "npm --prefix backend run test:e2e",
    "test:smoke": "npm --prefix backend run test:smoke",
    "test:db": "npm --prefix backend run test:db",
    "drill:backup": "npm --prefix backend run drill:backup",
    "test:all": "npm --prefix backend run test:all",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1"
  }
}
